      "com.b8b7.punchlist.PunchListClient"
    ]
  },
  "mixins": [
    "punchlist.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": ">=26.2",
    "fabric-api": "*",
